{
  "name": "dev-notes",
  "displayName": "Dev Notes",
  "description": "Sticky notes inside VS Code — capture questions and track them across meetings",
  "version": "1.0.0",
  "publisher": "thilina-jayaranga",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hktjayaranga/dev-notes"
  },
  "keywords": ["notes", "sticky", "todo", "meeting"],

  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devNotes",
          "title": "Dev Notes",
          "icon": "media/notes-icon.svg"
        }
      ]
    },
    "views": {
      "devNotes": [
        {
          "type": "webview",
          "id": "devNotesView",
          "name": "My Notes"
        }
      ]
    },
    "commands": [
      {
        "command": "devNotes.addNote",
        "title": "Add Dev Note"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
